{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["@shadcn/lint"],
  "rules": {
    "shadcn/no-arbitrary-values": "error"
  },
  "overrides": [
    {
      "files": ["components/ui/**"],
      "rules": {
        "shadcn/no-arbitrary-values": "off"
      }
    }
  ]
}
